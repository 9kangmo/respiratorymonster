# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 쿠키 암호화 키 (32자 이상 임의 문자열). 생성: openssl rand -base64 32
SESSION_SECRET=

# 로그인을 허용할 Google 계정 (쉼표로 구분). 배포 시 꼭 설정하세요.
ALLOWED_EMAILS=you@gmail.com

# 공개 주소. 비워 두면 요청 주소를 사용합니다. 배포 시 설정 권장.
# APP_URL=https://research.example.vercel.app

# 데이터 저장 위치: file(로컬 파일, 기본) | drive(Google Drive 앱 전용 폴더, Vercel에서는 기본값)
# STORAGE=file
# DATA_DIR=.data

# 날짜 계산에 쓸 시간대
TIMEZONE=Asia/Seoul

# ---------- 투자 리서치 ----------
# 로컬 모드에서 Claude Code 스킬이 결과 번들(JSON)을 떨어뜨리는 폴더. 화면을 열면 자동으로 가져옵니다.
# INVEST_INBOX_DIR=invest-inbox

# (선택) 앱 안에서 바로 Claude로 분석/갱신을 돌리려면 API 키를 넣으세요 (별도 과금).
# 비워 두면 Claude Code 스킬(구독 한도 안)로만 리서치를 만듭니다.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ---------- 매일 아침 자동 브리핑 (Vercel 배포 시) ----------
# 임의의 긴 문자열. Vercel이 예약 실행 요청에 이 값을 붙여 보냅니다. 생성: openssl rand -hex 32
# CRON_SECRET=
# 로그인 후 '투자 리서치 → 가져오기 · 설정 → 자동 실행 키 만들기'에서 복사한 값
# INVEST_CRON_TOKEN=
